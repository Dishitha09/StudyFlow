@startuml
title StudyFlow | Student use cases
left to right direction
skinparam backgroundColor #F8FAFD
skinparam defaultFontName Segoe UI
skinparam defaultFontColor #14213B
skinparam shadowing false
skinparam ArrowColor #506383
skinparam actorBorderColor #345279
skinparam actorBackgroundColor #EDF5FF
skinparam usecaseBorderColor #345279
skinparam usecaseBackgroundColor #EDF5FF
skinparam rectangleBorderColor #7F94B4
skinparam rectangleBackgroundColor #FFFFFF

actor Student
rectangle "StudyFlow | Stages 1 to 7" {
  usecase "Manage tasks and subtasks" as Task
  usecase "Create a task" as Create
  usecase "Validate task fields\nand references" as Validate
  usecase "Review deadlines, filters,\npriority and status groups" as Review
  usecase "Review dashboard and\ncomplete today's tasks" as Dashboard
  usecase "Choose an application theme" as Theme
  usecase "Manage subjects and\nworkspace membership" as Organize
  usecase "Manage subject notes" as Note
  usecase "Search tasks, subjects\nand notes" as Search
  usecase "Back up a saved data file" as Backup
  usecase "Restore local data\nfrom a backup" as Restore

  note right of Task
    Includes status changes, completion,
    priority, and recurring task setup.
  end note
}

Student -- Task
Student -- Create
Student -- Review
Student -- Dashboard
Student -- Theme
Student -- Organize
Student -- Note
Student -- Search
Student -- Backup
Student -- Restore
Create ..> Validate : <<include>>
@enduml
